; Engine configuration file.
; ASHEN KURULTAI
config_version=5

[application]
config/name="ASHEN KURULTAI"
config/description="A 3D souls-like set on a burned steppe after the last Kurultai."
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Game="*res://src/autoload/game.gd"
EventBus="*res://src/autoload/event_bus.gd"
SaveService="*res://src/autoload/save_service.gd"
InputBootstrap="*res://src/autoload/input_bootstrap.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="hurtbox"
3d_physics/layer_6="interact"

[physics]
3d/default_gravity=18.0

[rendering]
lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.05, 1)
